---
/**
 * Astro wrapper around split-reveal. The split runs while the page renders,
 * so nothing ships to the browser but markup and CSS.
 *
 * Import the stylesheet once in your layout:
 *   import 'split-reveal/css'
 */
import { splitText, type SplitOptions } from 'split-reveal';

// Extending SplitOptions rather than restating it: `mode`, `start`, `end`,
// `spread` and `step` then follow the library's own type, so a new option
// cannot arrive here as a silently untyped prop. Destructuring it below is the
// half that is not enforced: a prop left out there is dropped in silence.
interface Props extends SplitOptions {
  text: string;
  as?: 'span' | 'div' | 'p' | 'h1' | 'h2' | 'h3' | 'h4';
  class?: string;
}

const { text, mode, as = 'span', class: className, start, end, spread, step } = Astro.props;

const result = splitText(text, { mode, start, end, spread, step });
const Tag = as;
---
<Tag class:list={[className]} {...result.attributes} set:html={result.toHTML()} />
